{
  "expo": {
    "name": "DMM",
    "slug": "dmm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dmm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.disnana.moneymanagement",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "アプリのロック解除に使用します",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.disnana.mane_chan",
      "versionCode": 7,
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F3F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#000000" },
          "android": {
            "image": "./assets/launcher-icons/smile_mint-foreground.png",
            "imageWidth": 132,
            "backgroundColor": "#F3F7F6",
            "dark": {
              "image": "./assets/launcher-icons/smile_teal-foreground.png",
              "backgroundColor": "#0E1413"
            }
          }
        }
      ],
      "expo-sqlite",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "レシートを撮影するためにカメラを使用します",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-optional-receipt-camera",
      "./plugins/with-finance-backup",
      "./plugins/with-launcher-icons",
      "./plugins/with-optional-portrait-feature",
      "./plugins/with-android-build-commit",
      "./plugins/with-android-dependency-constraints"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
