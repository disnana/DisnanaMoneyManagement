digraph {

  graph [rankdir=TB, bgcolor=transparent, pad=.14, nodesep=.30, ranksep=.48, splines=polyline]
  node [shape=box, style="rounded,filled", margin=".18,.07", fontname="Noto Sans CJK JP, sans-serif", fontsize=14, fillcolor="#eaf3ef", color="#78a598", fontcolor="#16332c", penwidth=1.15]
  edge [fontname="Noto Sans CJK JP, sans-serif", fontsize=11, color="#52766b", fontcolor="#35594d", arrowsize=.7, penwidth=1.45]

  app [label="AndroidでGoogleログイン"]
  edgegate [label="Cloudflare Worker\n担当ノードを選ぶ", fillcolor="#fff1dc", color="#c58b51"]
  go [label="担当Goノード\nログインと端末を検証"]
  google [label="Google\nID・Play Integrity", fillcolor="#fff1dc", color="#c58b51"]
  db [label="ScyllaDB\n共有セッション", fillcolor="#d6eeea"]
  app -> edgegate [label="認証開始"]
  edgegate -> go [label="署名した発行依頼"]
  go -> google [label="照合"]
  go -> db [label="確立したセッションを保存"]
  {rank=same; go; google}
}
