digraph {

  graph [rankdir=TB, bgcolor=transparent, pad=.14, nodesep=.30, ranksep=.48, splines=polyline]
  node [shape=box, style="rounded,filled", margin=".18,.07", fontname="Noto Sans CJK JP, sans-serif", fontsize=14, fillcolor="#eaf3ef", color="#78a598", fontcolor="#16332c", penwidth=1.15]
  edge [fontname="Noto Sans CJK JP, sans-serif", fontsize=11, color="#52766b", fontcolor="#35594d", arrowsize=.7, penwidth=1.45]

  shop [label="Webショップ\n購入パックを選ぶ"]
  worker [label="Cloudflare Worker\n注文を保存して決済を開始", fillcolor="#fff1dc", color="#c58b51"]
  stripe [label="Stripe Checkout\n決済結果を通知", fillcolor="#fff1dc", color="#c58b51"]
  check [label="Workerで検証\n通知の署名・金額・支払状態"]
  go [label="Go・ScyllaDB\n同じ注文への付与は一度", fillcolor="#155951", color="#155951", fontcolor=white]
  shop -> worker -> stripe
  stripe -> check [label="Webhook"]
  check -> go [label="確認済みの注文"]
}
